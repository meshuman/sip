# Copy to .env.local and adjust.

# Public URL of the site, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fill the content files' open {{TODO}} items with the prototype's sample answers (src/lib/sample-fills.ts).
# Set to false to see the real gaps: they show as highlighted "To confirm" notes in development.
SAMPLE_CONTENT=true
